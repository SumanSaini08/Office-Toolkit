{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack enable && corepack prepare pnpm@11.27.1 --activate && pnpm install",
  "buildCommand": "pnpm --filter @workspace/office-toolkit run build:full",
  "outputDirectory": "artifacts/office-toolkit/dist/public",
  "routes": [
    {
      "src": "^/admin/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "dest": "/index.html"
    },
    {
      "src": "^/api/(.*)",
      "dest": "${BACKEND_URL}/api/$1",
      "env": ["BACKEND_URL"]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}